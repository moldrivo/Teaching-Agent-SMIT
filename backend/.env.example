# LLM provider: "mock" (offline, no key needed), "openai", or "opencode" (OpenCode Zen)
LLM_PROVIDER=mock

# Only used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only used when LLM_PROVIDER=opencode (OpenCode Zen, OpenAI-compatible)
OPENCODE_API_KEY=your_opencode_zen_free_key_here
OPENCODE_BASE_URL=https://api.opencode.zen/v1
OPENCODE_MODEL=gpt-4o-mini

# RAG vector store persistence
CHROMA_PERSIST_DIR=./data/chroma

# Chat history database
DB_PATH=./data/chat.db

# Max messages kept in history context
MAX_HISTORY=12
